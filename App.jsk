}

function InfoTab({ patient, onDeletePatient }) {
  return (
    <div className="space-y-3">
      <div className="bg-white border border-slate-100 rounded-xl divide-y divide-slate-100">
        <InfoRow icon={Phone} label="رقم الهاتف" value={patient.phone} />
        <InfoRow icon={MapPin} label="العنوان" value={patient.address} />
        <InfoRow icon={Activity} label="أمراض مزمنة" value={patient.chronic} />
        <InfoRow icon={AlertCircle} label="حساسية من أدوية" value={patient.allergies} />
        <InfoRow icon={FileText} label="ملاحظات عامة" value={patient.notes} />
      </div>
      <button
        onClick={onDeletePatient}
        className="w-full flex items-center justify-center gap-2 text-red-500 text-sm py-3 hover:bg-red-50 rounded-xl transition-colors"
      >
        <Trash2 className="w-4 h-4" /> حذف المريض نهائيًا
      </button>
