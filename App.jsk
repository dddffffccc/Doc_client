import React, { useState, useEffect, useRef } from 'react';
import {
  Stethoscope, Mail, AlertCircle, Loader2, ArrowRight, LogOut, Users, Calendar,
  Clock, UserPlus, Search, ChevronLeft, Phone, Plus, User, Edit2, TrendingUp,
  Pill, Image as ImageIcon, MapPin, Activity, FileText, Trash2, X, Upload, Check
} from 'lucide-react';
import { supabase } from './supabaseClient';

/* ---------------- Helpers ---------------- */
const genId = () => `${Date.now().toString(36)}${Math.random().toString(36).slice(2, 8)}`;

const todayISO = () => {
  const d = new Date();
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
};

const formatDateAr = (iso) => {
  if (!iso) return '—';
  const parts = String(iso).split('-');
  if (parts.length !== 3) return iso;
  const y = Number(parts[0]);
  const m = Number(parts[1]);
  const d = Number(parts[2]);
  const dateObj = new Date(y, m - 1, d);
  if (isNaN(dateObj.getTime())) return iso;
  return dateObj.toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });
};

const daysUntil = (iso) => {
  if (!iso) return null;
  const parts = String(iso).split('-');
  if (parts.length !== 3) return null;
  const y = Number(parts[0]);
  const m = Number(parts[1]);
  const d = Number(parts[2]);
  const target = new Date(y, m - 1, d).getTime();
  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
  return Math.round((target - today) / 86400000);
};

const resizeImageFile = (file, maxDim = 1280, quality = 0.72) =>
  new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onerror = () => reject(new Error('read-failed'));
    reader.onload = (e) => {
      const img = new Image();
      img.onerror = () => reject(new Error('image-failed'));
      img.onload = () => {
        let w = img.width;
        let h = img.height;
        if (w > maxDim || h > maxDim) {
          if (w > h) {
            h = Math.round((h * maxDim) / w);
            w = maxDim;
          } else {
            w = Math.round((w * maxDim) / h);
            h = maxDim;
          }
        }
        const canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, w, h);
        resolve(canvas.toDataURL('image/jpeg', quality));
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  });

/* ---------------- Row <-> JS object mapping ---------------- */
const patientFromRow = (r) => ({
  id: r.id,
  name: r.name,
  age: r.age,
  gender: r.gender,
  phone: r.phone,
  address: r.address,
  chronic: r.chronic,
  allergies: r.allergies,
  notes: r.notes,
  nextFollowUp: r.next_follow_up,
  lastVisit: r.last_visit,
  createdAt: r.created_at,
});

const visitFromRow = (r) => ({
  id: r.id,
  date: r.date,
  complaint: r.complaint,
  diagnosis: r.diagnosis,
  notes: r.notes,
  followUpDate: r.follow_up_date,
});

const progressFromRow = (r) => ({ id: r.id, date: r.date, status: r.status, note: r.note });

const rxFromRow = (r) => ({
  id: r.id,
  date: r.date,
  medications: r.medications || [],
  notes: r.notes,
  imageData: r.image_data,
});

const imageFromRow = (r) => ({ id: r.id, date: r.date, title: r.title, imageData: r.image_data, notes: r.notes });

/* ---------------- Small shared UI ---------------- */
function LoadingScreen() {
  return (
    <div className="min-h-screen flex items-center justify-center bg-white">
      <Loader2 className="w-8 h-8 text-teal-600 animate-spin" />
    </div>
  );
}

function AuthScreen({ onInfo }) {
  const [mode, setMode] = useState('login');
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState('');
  const [info, setInfo] = useState('');
  const [loading, setLoading] = useState(false);

  const submit = async () => {
    setError('');
    setInfo('');
    if (!email.trim() || password.length < 6) {
      setError('اكتب إيميل صحيح وباسورد 6 حروف على الأقل');
      return;
    }
    setLoading(true);
    try {
      if (mode === 'login') {
        const { error: err } = await supabase.auth.signInWithPassword({ email: email.trim(), password });
        if (err) throw err;
      } else {
        const { error: err } = await supabase.auth.signUp({ email: email.trim(), password });
        if (err) throw err;
        setInfo('تم إنشاء الحساب. لو محتاج تأكيد بالإيميل، افتح بريدك ودوس رابط التأكيد ثم سجّل دخول.');
      }
    } catch (err) {
      setError(err.message || 'حدث خطأ، حاول مرة أخرى');
    }
    setLoading(false);
  };

  return (
    <div className="min-h-screen bg-gradient-to-b from-teal-50 to-white flex items-center justify-center p-6" dir="rtl">
      <div className="w-full max-w-sm">
        <div className="flex flex-col items-center mb-8">
          <div className="w-16 h-16 rounded-2xl bg-teal-600 flex items-center justify-center mb-4 shadow-lg">
            <Stethoscope className="w-8 h-8 text-white" />
          </div>
          <h1 className="text-2xl font-bold text-slate-800">نظام إدارة العيادة</h1>
          <p className="text-slate-500 text-sm mt-1">{mode === 'login' ? 'تسجيل دخول الطبيب' : 'حساب جديد'}</p>
        </div>
        <div className="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 space-y-4">
          <div>
            <label className="text-sm text-slate-600 mb-1.5 block">البريد الإلكتروني</label>
            <input
              type="email"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
              className="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
              placeholder="doctor@example.com"
            />
          </div>
          <div>
            <label className="text-sm text-slate-600 mb-1.5 block">كلمة المرور</label>
            <input
              type="password"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
              className="w-full border border-slate-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
              placeholder="6 حروف على الأقل"
            />
          </div>
          {error && (
            <div className="flex items-center gap-2 text-red-600 text-sm bg-red-50 rounded-lg px-3 py-2">
              <AlertCircle className="w-4 h-4 flex-shrink-0" />
              <span>{error}</span>
            </div>
          )}
          {info && (
            <div className="flex items-center gap-2 text-teal-700 text-sm bg-teal-50 rounded-lg px-3 py-2">
              <Mail className="w-4 h-4 flex-shrink-0" />
              <span>{info}</span>
            </div>
          )}
          <button
            onClick={submit}
            disabled={loading}
            className="w-full bg-teal-600 hover:bg-teal-700 text-white rounded-xl py-3 font-medium transition-colors flex items-center justify-center gap-2 disabled:opacity-60"
          >
            {loading ? <Loader2 className="w-4 h-4 animate-spin" /> : null}
            {mode === 'login' ? 'دخول' : 'إنشاء حساب'}
          </button>
          <button
            onClick={() => {
              setMode(mode === 'login' ? 'signup' : 'login');
              setError('');
              setInfo('');
            }}
            className="w-full text-sm text-teal-600 font-medium"
          >
            {mode === 'login' ? 'مفيش حساب؟ اعمل واحد جديد' : 'عندك حساب؟ سجّل دخول'}
          </button>
        </div>
      </div>
    </div>
  );
}

function Header({ view, setView, onLogout, patientOpen, onBack }) {
  return (
    <div className="sticky top-0 z-20 bg-white border-b border-slate-100">
      <div className="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <div className="flex items-center gap-2">
          {patientOpen ? (
            <button onClick={onBack} className="p-2 -m-2 text-slate-500 hover:text-slate-700">
              <ArrowRight className="w-5 h-5" />
            </button>
          ) : (
            <div className="w-9 h-9 rounded-xl bg-teal-600 flex items-center justify-center">
              <Stethoscope className="w-5 h-5 text-white" />
            </div>
          )}
          <span className="font-bold text-slate-800">عيادتي</span>
        </div>
        {!patientOpen && (
          <nav className="flex items-center gap-1 bg-slate-100 rounded-xl p-1">
            <button
              onClick={() => setView('dashboard')}
              className={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
                view === 'dashboard' ? 'bg-white text-teal-700 shadow-sm' : 'text-slate-500'
              }`}
            >
              الرئيسية
            </button>
            <button
              onClick={() => setView('patients')}
              className={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
                view === 'patients' ? 'bg-white text-teal-700 shadow-sm' : 'text-slate-500'
              }`}
            >
              المرضى
            </button>
          </nav>
        )}
        <button onClick={onLogout} className="p-2 -m-2 text-slate-400 hover:text-red-500 transition-colors">
          <LogOut className="w-5 h-5" />
        </button>
      </div>
    </div>
  );
}

function StatCard({ icon: Icon, label, value, color }) {
  const colors = {
    teal: 'bg-teal-50 text-teal-600',
    blue: 'bg-blue-50 text-blue-600',
    amber: 'bg-amber-50 text-amber-600',
  };
  return (
    <div className="bg-white border border-slate-100 rounded-2xl p-4">
      <div className={`w-9 h-9 rounded-xl flex items-center justify-center mb-3 ${colors[color]}`}>
        <Icon className="w-4 h-4" />
      </div>
      <div className="text-2xl font-bold text-slate-800">{value}</div>
      <div className="text-xs text-slate-400 mt-0.5">{label}</div>
    </div>
  );
}

function PatientRow({ patient, onClick }) {
  return (
    <button
      onClick={onClick}
      className="w-full flex items-center gap-3 bg-white border border-slate-100 rounded-xl px-4 py-3 hover:border-teal-200 transition-colors text-right"
    >
      <div className="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 font-semibold flex-shrink-0">
        {(patient.name && patient.name.trim()[0]) || '؟'}
      </div>
      <div className="flex-1 min-w-0">
        <div className="font-medium text-slate-800 truncate">{patient.name}</div>
        <div className="text-xs text-slate-400 mt-0.5 flex items-center gap-2">
          {patient.age && <span>{patient.age} سنة</span>}
          {patient.phone && (
            <span className="flex items-center gap-1">
              <Phone className="w-3 h-3" /> {patient.phone}
            </span>
          )}
        </div>
      </div>
      <ChevronLeft className="w-4 h-4 text-slate-300 flex-shrink-0" />
    </button>
  );
}

function EmptyState({ icon: Icon, text }) {
  return (
    <div className="flex flex-col items-center justify-center py-10 text-center">
      <div className="w-12 h-12 rounded-full bg-slate-50 flex items-center justify-center mb-3">
        <Icon className="w-5 h-5 text-slate-300" />
      </div>
      <p className="text-sm text-slate-400">{text}</p>
    </div>
  );
}

/* ---------------- Dashboard ---------------- */
function Dashboard({ patients, onOpenPatient, onAddPatient, onGoPatients }) {
  const today = todayISO();
  const totalPatients = patients.length;
  const todayVisits = patients.filter((p) => p.lastVisit === today).length;
  const upcoming = patients
    .filter((p) => p.nextFollowUp)
    .map((p) => ({ ...p, d: daysUntil(p.nextFollowUp) }))
    .filter((p) => p.d !== null && p.d >= 0 && p.d <= 14)
    .sort((a, b) => a.d - b.d);

  return (
    <div className="max-w-5xl mx-auto px-4 py-6 space-y-6">
      <div className="grid grid-cols-3 gap-3">
        <StatCard icon={Users} label="إجمالي المرضى" value={totalPatients} color="teal" />
        <StatCard icon={Calendar} label="كشوفات اليوم" value={todayVisits} color="blue" />
        <StatCard icon={Clock} label="إعادات قريبة" value={upcoming.length} color="amber" />
      </div>

      <div className="flex gap-3">
        <button
          onClick={onAddPatient}
          className="flex-1 flex items-center justify-center gap-2 bg-teal-600 hover:bg-teal-700 text-white rounded-xl py-3 font-medium transition-colors"
        >
          <UserPlus className="w-4 h-4" /> إضافة مريض جديد
        </button>
        <button
          onClick={onGoPatients}
          className="flex-1 flex items-center justify-center gap-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 rounded-xl py-3 font-medium transition-colors"
        >
          <Search className="w-4 h-4" /> كل المرضى
        </button>
      </div>

      <div>
        <h2 className="text-sm font-semibold text-slate-500 mb-3">مواعيد الإعادة القادمة</h2>
        {upcoming.length === 0 ? (
          <EmptyState icon={Clock} text="لا توجد إعادات خلال الأسبوعين القادمين" />
        ) : (
          <div className="space-y-2">
            {upcoming.map((p) => (
              <button
                key={p.id}
                onClick={() => onOpenPatient(p.id)}
                className="w-full flex items-center justify-between bg-white border border-slate-100 rounded-xl px-4 py-3 hover:border-teal-200 transition-colors text-right"
              >
                <div>
                  <div className="font-medium text-slate-800">{p.name}</div>
                  <div className="text-xs text-slate-400 mt-0.5">{formatDateAr(p.nextFollowUp)}</div>
                </div>
                <span
                  className={`text-xs font-medium px-2.5 py-1 rounded-full flex-shrink-0 ${
                    p.d === 0 ? 'bg-red-50 text-red-600' : p.d <= 3 ? 'bg-amber-50 text-amber-600' : 'bg-slate-50 text-slate-500'
                  }`}
                >
                  {p.d === 0 ? 'اليوم' : `بعد ${p.d} يوم`}
                </span>
              </button>
            ))}
          </div>
        )}
      </div>

      <div>
        <h2 className="text-sm font-semibold text-slate-500 mb-3">أحدث المرضى</h2>
        {patients.length === 0 ? (
          <EmptyState icon={Users} text="لم تتم إضافة أي مريض بعد" />
        ) : (
          <div className="space-y-2">
            {patients.slice(0, 5).map((p) => (
              <PatientRow key={p.id} patient={p} onClick={() => onOpenPatient(p.id)} />
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

/* ---------------- Patient list ---------------- */
function PatientList({ patients, search, setSearch, onOpenPatient, onAddPatient }) {
  const q = search.trim().toLowerCase();
  const filtered = patients.filter((p) => {
    if (!q) return true;
    return (p.name && p.name.toLowerCase().includes(q)) || (p.phone && p.phone.includes(q));
  });
  return (
    <div className="max-w-5xl mx-auto px-4 py-6 space-y-4">
      <div className="flex gap-2">
        <div className="relative flex-1">
          <Search className="w-4 h-4 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2" />
          <input
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder="ابحث بالاسم أو رقم الهاتف"
            className="w-full border border-slate-200 rounded-xl py-2.5 pr-10 pl-3 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
          />
        </div>
        <button
          onClick={onAddPatient}
          className="bg-teal-600 hover:bg-teal-700 text-white rounded-xl px-4 flex items-center gap-1.5 text-sm font-medium flex-shrink-0"
        >
          <Plus className="w-4 h-4" /> جديد
        </button>
      </div>
      {filtered.length === 0 ? (
        <EmptyState icon={Users} text={search ? 'لا توجد نتائج' : 'لم تتم إضافة أي مريض بعد'} />
      ) : (
        <div className="space-y-2">
          {filtered.map((p) => (
            <PatientRow key={p.id} patient={p} onClick={() => onOpenPatient(p.id)} />
          ))}
        </div>
      )}
    </div>
  );
}

/* ---------------- Patient detail ---------------- */
function InfoRow({ icon: Icon, label, value }) {
  return (
    <div className="flex items-start gap-3 px-4 py-3">
      <Icon className="w-4 h-4 text-slate-300 mt-0.5 flex-shrink-0" />
      <div className="flex-1 min-w-0">
        <div className="text-xs text-slate-400">{label}</div>
        <div className="text-sm text-slate-700 mt-0.5 break-words">{value || '—'}</div>
      </div>
    </div>
