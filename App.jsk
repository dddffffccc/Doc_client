  );
}

function CardShell({ date, badge, badgeColor, onDelete, children }) {
  return (
    <div className="bg-white border border-slate-100 rounded-xl p-4">
      <div className="flex items-center justify-between mb-2">
        <span className="text-xs text-slate-400 flex items-center gap-1">
          <Clock className="w-3 h-3" /> {formatDateAr(date)}
        </span>
        <div className="flex items-center gap-2">
          {badge && <span className={`text-xs px-2 py-0.5 rounded-full ${badgeColor}`}>{badge}</span>}
          <button onClick={onDelete} className="text-slate-300 hover:text-red-500">
            <Trash2 className="w-3.5 h-3.5" />
          </button>
        </div>
      </div>
      {children}
    </div>
  );
}

function VisitCard({ visit, onDelete }) {
  return (
    <CardShell date={visit.date} onDelete={onDelete}>
      {visit.complaint && (
        <div className="text-sm text-slate-700">
          <span className="text-slate-400">الشكوى: </span>
          {visit.complaint}
        </div>
      )}
      {visit.diagnosis && (
        <div className="text-sm text-slate-700 mt-1">
          <span className="text-slate-400">التشخيص: </span>
          {visit.diagnosis}
        </div>
      )}
      {visit.notes && <div className="text-sm text-slate-500 mt-1">{visit.notes}</div>}
      {visit.followUpDate && (
        <div className="text-xs text-amber-600 bg-amber-50 rounded-lg px-2.5 py-1.5 mt-2 inline-flex items-center gap-1">
          <Calendar className="w-3 h-3" /> إعادة يوم {formatDateAr(visit.followUpDate)}
        </div>
      )}
    </CardShell>
  );
}

function ProgressCard({ note, onDelete }) {
  const statusColors = {
    'تحسن': 'bg-green-50 text-green-600',
    'ثبات': 'bg-slate-100 text-slate-500',
    'تدهور': 'bg-red-50 text-red-600',
  };
  return (
    <CardShell date={note.date} badge={note.status} badgeColor={statusColors[note.status] || 'bg-slate-100 text-slate-500'} onDelete={onDelete}>
      <p className="text-sm text-slate-700">{note.note}</p>
    </CardShell>
  );
}

function PrescriptionCard({ rx, onDelete }) {
  return (
    <CardShell date={rx.date} onDelete={onDelete}>
      {rx.medications && rx.medications.length > 0 && (
        <div className="space-y-1.5">
          {rx.medications.map((m, i) => (
            <div key={i} className="flex items-start gap-2 text-sm">
              <Pill className="w-3.5 h-3.5 text-teal-500 mt-0.5 flex-shrink-0" />
              <span className="text-slate-700">
                {m.name}
                {m.dose ? ` — ${m.dose}` : ''}
                {m.duration ? ` — ${m.duration}` : ''}
              </span>
            </div>
          ))}
        </div>
      )}
      {rx.notes && <div className="text-sm text-slate-500 mt-2">{rx.notes}</div>}
      {rx.imageData && <img src={rx.imageData} alt="روشتة" className="mt-2 rounded-lg max-h-40 border border-slate-100" />}
    </CardShell>
  );
}

function ListTab({ items, loading, emptyText, emptyIcon, onAdd, addLabel, renderItem }) {
  return (
    <div className="space-y-3">
      <button
        onClick={onAdd}
        disabled={loading}
        className={`w-full flex items-center justify-center gap-2 rounded-xl py-2.5 text-sm font-medium transition-colors ${
          loading ? 'bg-slate-100 text-slate-400' : 'bg-teal-600 hover:bg-teal-700 text-white'
        }`}
      >
        <Plus className="w-4 h-4" /> {addLabel}
      </button>
      {loading ? (
        <div className="flex justify-center py-8">
          <Loader2 className="w-5 h-5 text-teal-600 animate-spin" />
        </div>
      ) : items.length === 0 ? (
        <EmptyState icon={emptyIcon} text={emptyText} />
      ) : (
        <div className="space-y-2">{items.map(renderItem)}</div>
      )}
    </div>
  );
}

function ImagesTab({ images, loading, onAdd, onDelete, onView }) {
  return (
    <div className="space-y-3">
      <button
        onClick={onAdd}
        disabled={loading}
        className={`w-full flex items-center justify-center gap-2 rounded-xl py-2.5 text-sm font-medium transition-colors ${
          loading ? 'bg-slate-100 text-slate-400' : 'bg-teal-600 hover:bg-teal-700 text-white'
        }`}
      >
        <Upload className="w-4 h-4" /> رفع صورة أشعة أو تحليل
      </button>
      {loading ? (
        <div className="flex justify-center py-8">
          <Loader2 className="w-5 h-5 text-teal-600 animate-spin" />
        </div>
      ) : images.length === 0 ? (
        <EmptyState icon={ImageIcon} text="لا توجد صور مرفوعة بعد" />
      ) : (
        <div className="grid grid-cols-2 gap-3">
          {images.map((img) => (
            <div key={img.id} className="bg-white border border-slate-100 rounded-xl overflow-hidden">
              <button onClick={() => onView(img)} className="block w-full aspect-square bg-slate-50">
                <img src={img.imageData} alt={img.title || 'صورة'} className="w-full h-full object-cover" />
              </button>
              <div className="p-2.5 flex items-center justify-between gap-2">
                <div className="min-w-0">
                  <div className="text-xs font-medium text-slate-700 truncate">{img.title || 'بدون عنوان'}</div>
                  <div className="text-xs text-slate-400">{formatDateAr(img.date)}</div>
                </div>
                <button onClick={() => onDelete(img)} className="text-slate-300 hover:text-red-500 flex-shrink-0">
                  <Trash2 className="w-3.5 h-3.5" />
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

function PatientDetail({ patient, records, recordsLoading, images, imagesLoading, activeTab, setActiveTab, onDeletePatient, onOpenModal, onDeleteItem, onDeleteImage }) {
  const tabs = [
    { id: 'info', label: 'البيانات', icon: User },
    { id: 'visits', label: 'الكشوفات', icon: Calendar },
    { id: 'progress', label: 'السجل والتطور', icon: TrendingUp },
    { id: 'prescriptions', label: 'الروشتات', icon: Pill },
    { id: 'images', label: 'الأشعة والصور', icon: ImageIcon },
  ];
  return (
    <div className="max-w-5xl mx-auto px-4 py-6">
      <div className="flex items-start justify-between mb-4">
        <div className="flex items-center gap-3">
          <div className="w-14 h-14 rounded-full bg-teal-50 text-teal-700 flex items-center justify-center text-xl font-bold flex-shrink-0">
            {(patient.name && patient.name.trim()[0]) || '؟'}
          </div>
          <div>
            <h1 className="text-lg font-bold text-slate-800">{patient.name}</h1>
            <div className="text-xs text-slate-400 mt-0.5">
              {patient.age ? `${patient.age} سنة` : ''} {patient.gender ? `• ${patient.gender === 'male' ? 'ذكر' : 'أنثى'}` : ''}
            </div>
          </div>
        </div>
        <button onClick={() => onOpenModal({ type: 'editPatient', patient })} className="p-2 text-slate-400 hover:text-teal-600 flex-shrink-0">
          <Edit2 className="w-4 h-4" />
        </button>
      </div>

      <div className="flex gap-1.5 overflow-x-auto pb-1 mb-4 -mx-4 px-4">
        {tabs.map((t) => {
          const Icon = t.icon;
          const isActive = activeTab === t.id;
          return (
            <button
              key={t.id}
              onClick={() => setActiveTab(t.id)}
              className={`flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-colors flex-shrink-0 ${
                isActive ? 'bg-teal-600 text-white' : 'bg-slate-100 text-slate-500'
              }`}
            >
              <Icon className="w-3.5 h-3.5" /> {t.label}
            </button>
          );
        })}
      </div>

      {activeTab === 'info' && <InfoTab patient={patient} onDeletePatient={onDeletePatient} />}

      {activeTab === 'visits' && (
        <ListTab
          items={records.visits}
          loading={recordsLoading}
          emptyText="لا توجد كشوفات مسجلة بعد"
          emptyIcon={Calendar}
          onAdd={() => onOpenModal({ type: 'addVisit', patientId: patient.id })}
          addLabel="تسجيل كشف جديد"
          renderItem={(v) => (
            <VisitCard key={v.id} visit={v} onDelete={() => onDeleteItem('visits', v.id, `كشف ${formatDateAr(v.date)}`)} />
          )}
        />
      )}

      {activeTab === 'progress' && (
        <ListTab
          items={records.progress}
          loading={recordsLoading}
          emptyText="لا يوجد سجل تطور بعد"
          emptyIcon={TrendingUp}
          onAdd={() => onOpenModal({ type: 'addProgress', patientId: patient.id })}
          addLabel="إضافة تطور جديد"
          renderItem={(n) => (
            <ProgressCard key={n.id} note={n} onDelete={() => onDeleteItem('progress', n.id, `تطور ${formatDateAr(n.date)}`)} />
          )}
        />
      )}

      {activeTab === 'prescriptions' && (
        <ListTab
          items={records.prescriptions}
          loading={recordsLoading}
          emptyText="لا توجد روشتات مسجلة بعد"
          emptyIcon={Pill}
          onAdd={() => onOpenModal({ type: 'addPrescription', patientId: patient.id })}
          addLabel="كتابة روشتة جديدة"
          renderItem={(rx) => (
            <PrescriptionCard key={rx.id} rx={rx} onDelete={() => onDeleteItem('prescriptions', rx.id, `روشتة ${formatDateAr(rx.date)}`)} />
          )}
        />
      )}

      {activeTab === 'images' && (
        <ImagesTab
          images={images}
          loading={imagesLoading}
          onAdd={() => onOpenModal({ type: 'addImage', patientId: patient.id })}
          onDelete={(img) => onDeleteImage(img.id, img.title || formatDateAr(img.date))}
          onView={(img) => onOpenModal({ type: 'viewImage', image: img })}
        />
      )}
    </div>
  );
}

/* ---------------- Modal + form atoms ---------------- */
function Modal({ title, onClose, children }) {
  return (
    <div
      className="fixed inset-0 z-30 flex items-end sm:items-center justify-center backdrop-blur-sm"
      style={{ backgroundColor: 'rgba(15,23,42,0.45)' }}
      dir="rtl"
    >
      <div className="bg-white w-full sm:max-w-md sm:rounded-2xl rounded-t-2xl max-h-screen flex flex-col">
        <div className="flex items-center justify-between px-5 py-4 border-b border-slate-100 flex-shrink-0">
          <h3 className="font-bold text-slate-800">{title}</h3>
          <button onClick={onClose} className="p-1 text-slate-400 hover:text-slate-600">
            <X className="w-5 h-5" />
          </button>
        </div>
        <div className="overflow-y-auto px-5 py-4 space-y-4">{children}</div>
      </div>
    </div>
  );
}

function TextField({ label, value, onChange, placeholder, type = 'text', required }) {
  return (
    <div>
      <label className="text-sm text-slate-600 mb-1.5 block">
        {label}
        {required && <span className="text-red-400"> *</span>}
      </label>
      <input
        type={type}
        value={value}
        onChange={(e) => onChange(e.target.value)}
        placeholder={placeholder}
        className="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
      />
    </div>
  );
}

function TextAreaField({ label, value, onChange, placeholder, rows = 3 }) {
  return (
    <div>
      <label className="text-sm text-slate-600 mb-1.5 block">{label}</label>
      <textarea
        value={value}
        onChange={(e) => onChange(e.target.value)}
        placeholder={placeholder}
        rows={rows}
        className="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500 resize-none"
      />
    </div>
  );
}

function ConfirmDialog({ label, onConfirm, onCancel }) {
  return (
    <div
      className="fixed inset-0 z-40 flex items-center justify-center p-4 backdrop-blur-sm"
      style={{ backgroundColor: 'rgba(15,23,42,0.45)' }}
      dir="rtl"
    >
      <div className="bg-white rounded-2xl p-5 w-full max-w-xs text-center">
        <div className="w-11 h-11 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-3">
          <AlertCircle className="w-5 h-5 text-red-500" />
        </div>
        <p className="text-sm text-slate-700 mb-4">هل أنت متأكد من حذف {label}؟ لا يمكن التراجع عن هذا الإجراء.</p>
        <div className="flex gap-2">
          <button onClick={onConfirm} className="flex-1 bg-red-500 hover:bg-red-600 text-white rounded-xl py-2.5 text-sm font-medium">
            حذف
          </button>
          <button onClick={onCancel} className="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl py-2.5 text-sm font-medium">
            إلغاء
          </button>
        </div>
      </div>
    </div>
  );
}

function ToastView({ toast }) {
  if (!toast) return null;
  return (
    <div
      className="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 bg-slate-800 text-white text-sm px-4 py-2.5 rounded-xl shadow-lg flex items-center gap-2"
      dir="rtl"
    >
      {toast.type === 'error' ? (
        <AlertCircle className="w-4 h-4 text-red-400 flex-shrink-0" />
      ) : (
        <Check className="w-4 h-4 text-green-400 flex-shrink-0" />
      )}
      {toast.text}
    </div>
  );
}

/* ---------------- Forms ---------------- */
function PatientForm({ initial, onSubmit, onCancel }) {
  const [name, setName] = useState((initial && initial.name) || '');
  const [age, setAge] = useState((initial && initial.age) || '');
  const [gender, setGender] = useState((initial && initial.gender) || 'male');
  const [phone, setPhone] = useState((initial && initial.phone) || '');
  const [address, setAddress] = useState((initial && initial.address) || '');
  const [chronic, setChronic] = useState((initial && initial.chronic) || '');
  const [allergies, setAllergies] = useState((initial && initial.allergies) || '');
  const [notes, setNotes] = useState((initial && initial.notes) || '');
  const [error, setError] = useState('');

  const submit = () => {
    if (!name.trim()) {
      setError('اسم المريض مطلوب');
      return;
    }
    onSubmit({ name, age, gender, phone, address, chronic, allergies, notes });
  };

  return (
    <div className="space-y-4">
      <TextField label="اسم المريض" value={name} onChange={setName} placeholder="مثال: أحمد محمد" required />
      <div className="grid grid-cols-2 gap-3">
        <TextField label="السن" value={age} onChange={setAge} type="number" placeholder="مثال: 35" />
        <div>
          <label className="text-sm text-slate-600 mb-1.5 block">النوع</label>
          <select
            value={gender}
            onChange={(e) => setGender(e.target.value)}
            className="w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
          >
            <option value="male">ذكر</option>
            <option value="female">أنثى</option>
          </select>
        </div>
      </div>
      <TextField label="رقم الهاتف" value={phone} onChange={setPhone} placeholder="01xxxxxxxxx" />
      <TextField label="العنوان" value={address} onChange={setAddress} />
      <TextAreaField label="أمراض مزمنة" value={chronic} onChange={setChronic} placeholder="سكر، ضغط..." rows={2} />
      <TextAreaField label="حساسية من أدوية" value={allergies} onChange={setAllergies} rows={2} />
      <TextAreaField label="ملاحظات عامة" value={notes} onChange={setNotes} rows={2} />
      {error && <div className="text-red-500 text-sm">{error}</div>}
      <div className="flex gap-2 pt-2">
        <button onClick={submit} className="flex-1 bg-teal-600 hover:bg-teal-700 text-white rounded-xl py-2.5 text-sm font-medium">
          حفظ
        </button>
        <button onClick={onCancel} className="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl py-2.5 text-sm font-medium">
          إلغاء
        </button>
      </div>
    </div>
  );
}

function VisitForm({ onSubmit, onCancel }) {
  const [date, setDate] = useState(todayISO());
  const [complaint, setComplaint] = useState('');
  const [diagnosis, setDiagnosis] = useState('');
  const [notes, setNotes] = useState('');
  const [followUpDate, setFollowUpDate] = useState('');

  return (
    <div className="space-y-4">
      <TextField label="تاريخ الكشف" value={date} onChange={setDate} type="date" required />
      <TextAreaField label="الشكوى / سبب الزيارة" value={complaint} onChange={setComplaint} rows={2} />
      <TextAreaField label="التشخيص" value={diagnosis} onChange={setDiagnosis} rows={2} />
      <TextAreaField label="ملاحظات الطبيب" value={notes} onChange={setNotes} rows={3} />
      <TextField label="تاريخ الإعادة (اختياري)" value={followUpDate} onChange={setFollowUpDate} type="date" />
      <div className="flex gap-2 pt-2">
        <button
          onClick={() => onSubmit({ date, complaint, diagnosis, notes, followUpDate })}
          className="flex-1 bg-teal-600 hover:bg-teal-700 text-white rounded-xl py-2.5 text-sm font-medium"
        >
          حفظ الكشف
        </button>
        <button onClick={onCancel} className="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl py-2.5 text-sm font-medium">
          إلغاء
        </button>
      </div>
    </div>
  );
}

function ProgressForm({ onSubmit, onCancel }) {
  const [date, setDate] = useState(todayISO());
  const [status, setStatus] = useState('تحسن');
  const [note, setNote] = useState('');

  return (
    <div className="space-y-4">
      <TextField label="التاريخ" value={date} onChange={setDate} type="date" />
      <div>
        <label className="text-sm text-slate-600 mb-1.5 block">الحالة</label>
        <div className="flex gap-2">
          {['تحسن', 'ثبات', 'تدهور'].map((s) => (
            <button
              key={s}
              onClick={() => setStatus(s)}
              className={`flex-1 py-2 rounded-xl text-sm font-medium border transition-colors ${
                status === s ? 'bg-teal-600 text-white border-teal-600' : 'bg-white text-slate-500 border-slate-200'
              }`}
            >
              {s}
            </button>
          ))}
        </div>
      </div>
      <TextAreaField label="وصف التطور" value={note} onChange={setNote} rows={4} placeholder="اكتب ملاحظاتك عن تطور حالة المريض..." />
      <div className="flex gap-2 pt-2">
        <button
          onClick={() => onSubmit({ date, status, note })}
          className="flex-1 bg-teal-600 hover:bg-teal-700 text-white rounded-xl py-2.5 text-sm font-medium"
        >
          حفظ
        </button>
        <button onClick={onCancel} className="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl py-2.5 text-sm font-medium">
          إلغاء
        </button>
      </div>
    </div>
  );
}

function PrescriptionForm({ onSubmit, onCancel }) {
  const [date, setDate] = useState(todayISO());
  const [meds, setMeds] = useState([{ name: '', dose: '', duration: '' }]);
  const [notes, setNotes] = useState('');
  const [imageData, setImageData] = useState(null);
  const [uploading, setUploading] = useState(false);
  const fileRef = useRef(null);

  const updateMed = (i, field, val) => {
    setMeds(meds.map((m, idx) => (idx === i ? { ...m, [field]: val } : m)));
  };
  const addMedRow = () => setMeds([...meds, { name: '', dose: '', duration: '' }]);
  const removeMedRow = (i) => setMeds(meds.filter((_, idx) => idx !== i));

  const handleFile = async (e) => {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    setUploading(true);
    try {
      const data = await resizeImageFile(file);
      setImageData(data);
    } catch (err) {
      // keep silent, user can retry
    }
    setUploading(false);
  };

  const submit = () => {
    const cleanedMeds = meds.filter((m) => m.name.trim());
    onSubmit({ date, medications: cleanedMeds, notes, imageData });
  };

  return (
    <div className="space-y-4">
      <TextField label="التاريخ" value={date} onChange={setDate} type="date" />
      <div>
        <label className="text-sm text-slate-600 mb-1.5 block">الأدوية</label>
        <div className="space-y-2">
          {meds.map((m, i) => (
            <div key={i} className="bg-slate-50 rounded-xl p-3 space-y-2">
              <div className="flex gap-2">
                <input
                  value={m.name}
                  onChange={(e) => updateMed(i, 'name', e.target.value)}
                  placeholder="اسم الدواء"
                  className="flex-1 border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                />
                {meds.length > 1 && (
                  <button onClick={() => removeMedRow(i)} className="text-slate-300 hover:text-red-500 px-1">
                    <X className="w-4 h-4" />
                  </button>
                )}
              </div>
              <div className="grid grid-cols-2 gap-2">
                <input
                  value={m.dose}
                  onChange={(e) => updateMed(i, 'dose', e.target.value)}
                  placeholder="الجرعة"
                  className="border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                />
                <input
                  value={m.duration}
                  onChange={(e) => updateMed(i, 'duration', e.target.value)}
                  placeholder="مدة العلاج"
                  className="border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                />
              </div>
            </div>
          ))}
        </div>
        <button onClick={addMedRow} className="mt-2 text-sm text-teal-600 font-medium flex items-center gap-1">
          <Plus className="w-3.5 h-3.5" /> إضافة دواء آخر
        </button>
      </div>
      <TextAreaField label="ملاحظات" value={notes} onChange={setNotes} rows={2} />
      <div>
        <label className="text-sm text-slate-600 mb-1.5 block">أو ارفع صورة روشتة جاهزة (اختياري)</label>
        {imageData ? (
          <div className="relative inline-block">
            <img src={imageData} alt="روشتة" className="rounded-xl max-h-40 border border-slate-200" />
            <button onClick={() => setImageData(null)} className="absolute top-2 left-2 bg-white rounded-full p-1">
              <X className="w-4 h-4 text-slate-600" />
            </button>
          </div>
        ) : (
          <button
            onClick={() => fileRef.current && fileRef.current.click()}
            disabled={uploading}
            className="w-full border-2 border-dashed border-slate-200 rounded-xl py-6 flex flex-col items-center gap-1.5 text-slate-400 hover:border-teal-300 hover:text-teal-500 transition-colors"
          >
            {uploading ? <Loader2 className="w-5 h-5 animate-spin" /> : <Upload className="w-5 h-5" />}
            <span className="text-xs">{uploading ? 'جاري الرفع...' : 'اضغط لاختيار صورة'}</span>
          </button>
        )}
        <input ref={fileRef} type="file" accept="image/*" onChange={handleFile} className="hidden" />
      </div>
      <div className="flex gap-2 pt-2">
        <button onClick={submit} className="flex-1 bg-teal-600 hover:bg-teal-700 text-white rounded-xl py-2.5 text-sm font-medium">
          حفظ الروشتة
        </button>
        <button onClick={onCancel} className="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl py-2.5 text-sm font-medium">
          إلغاء
        </button>
      </div>
    </div>
  );
}

function ImageUploadForm({ onSubmit, onCancel }) {
  const [date, setDate] = useState(todayISO());
  const [title, setTitle] = useState('');
  const [notes, setNotes] = useState('');
  const [imageData, setImageData] = useState(null);
  const [uploading, setUploading] = useState(false);
  const [error, setError] = useState('');
  const fileRef = useRef(null);

  const handleFile = async (e) => {
    const file = e.target.files && e.target.files[0];
    if (!file) return;
    setUploading(true);
    setError('');
    try {
      const data = await resizeImageFile(file, 1600, 0.75);
      setImageData(data);
    } catch (err) {
      setError('تعذر تحميل الصورة، جرب صورة أخرى');
    }
    setUploading(false);
  };

  const submit = () => {
    if (!imageData) {
      setError('من فضلك اختر صورة أولاً');
      return;
    }
    onSubmit({ date, title, notes, imageData });
  };

  return (
    <div className="space-y-4">
      {imageData ? (
        <div className="relative">
          <img src={imageData} alt="صورة" className="rounded-xl w-full max-h-56 object-contain bg-slate-50 border border-slate-200" />
          <button onClick={() => setImageData(null)} className="absolute top-2 left-2 bg-white rounded-full p-1">
            <X className="w-4 h-4 text-slate-600" />
          </button>
        </div>
      ) : (
        <button
          onClick={() => fileRef.current && fileRef.current.click()}
          disabled={uploading}
          className="w-full border-2 border-dashed border-slate-200 rounded-xl py-8 flex flex-col items-center gap-2 text-slate-400 hover:border-teal-300 hover:text-teal-500 transition-colors"
        >
          {uploading ? <Loader2 className="w-6 h-6 animate-spin" /> : <ImageIcon className="w-6 h-6" />}
          <span className="text-sm">{uploading ? 'جاري التحميل...' : 'اضغط لاختيار صورة الأشعة أو التحليل'}</span>
        </button>
      )}
      <input ref={fileRef} type="file" accept="image/*" onChange={handleFile} className="hidden" />
      <TextField label="عنوان الصورة" value={title} onChange={setTitle} placeholder="مثال: أشعة صدر، تحليل دم" />
      <TextField label="التاريخ" value={date} onChange={setDate} type="date" />
      <TextAreaField label="ملاحظات" value={notes} onChange={setNotes} rows={2} />
      {error && <div className="text-red-500 text-sm">{error}</div>}
      <div className="flex gap-2 pt-2">
        <button onClick={submit} className="flex-1 bg-teal-600 hover:bg-teal-700 text-white rounded-xl py-2.5 text-sm font-medium">
          حفظ
        </button>
        <button onClick={onCancel} className="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl py-2.5 text-sm font-medium">
          إلغاء
        </button>
      </div>
    </div>
  );
}

/* ---------------- Main App ---------------- */
export default function App() {
  const [booting, setBooting] = useState(true);
  const [user, setUser] = useState(null);

  const [patients, setPatients] = useState([]);
  const [view, setView] = useState('dashboard');
  const [activePatientId, setActivePatientId] = useState(null);
  const [activeTab, setActiveTab] = useState('info');
  const [search, setSearch] = useState('');

  const [recordsCache, setRecordsCache] = useState({});
  const [imagesCache, setImagesCache] = useState({});

  const [modal, setModal] = useState(null);
  const [toast, setToast] = useState(null);
  const [confirmDelete, setConfirmDelete] = useState(null);

  const toastTimerRef = useRef(null);
  const loadedImageIdsRef = useRef(new Set());

  useEffect(() => {
    supabase.auth.getSession().then(({ data }) => {
      setUser(data.session ? data.session.user : null);
      setBooting(false);
    });
    const { data: listener } = supabase.auth.onAuthStateChange((_event, session) => {
      setUser(session ? session.user : null);
      if (!session) {
        setPatients([]);
        setRecordsCache({});
        setImagesCache({});
        setView('dashboard');
        setActivePatientId(null);
      }
    });
    return () => listener.subscription.unsubscribe();
  }, []);

  const showToast = (text, type = 'success') => {
    setToast({ text, type });
    if (toastTimerRef.current) clearTimeout(toastTimerRef.current);
    toastTimerRef.current = setTimeout(() => setToast(null), 2500);
  };

  const loadPatients = async () => {
    const { data, error } = await supabase.from('patients').select('*').order('created_at', { ascending: false });
    if (error) {
      showToast('تعذر تحميل بيانات المرضى', 'error');
      return;
    }
    setPatients((data || []).map(patientFromRow));
  };

  useEffect(() => {
    if (user) loadPatients();
  }, [user]);

  useEffect(() => {
    if (
      view === 'patientDetail' &&
      activeTab === 'images' &&
      activePatientId &&
      !loadedImageIdsRef.current.has(activePatientId)
    ) {
      loadedImageIdsRef.current.add(activePatientId);
      (async () => {
        const { data, error } = await supabase
          .from('patient_images')
          .select('*')
          .eq('patient_id', activePatientId)
          .order('date', { ascending: false });
        const imgs = error ? [] : (data || []).map(imageFromRow);
        setImagesCache((prev) => ({ ...prev, [activePatientId]: imgs }));
      })();
    }
  }, [view, activeTab, activePatientId]);

  const openPatient = async (id) => {
    setActivePatientId(id);
    setActiveTab('info');
    setView('patientDetail');
    if (recordsCache[id] === undefined) {
      const [v, p, rx] = await Promise.all([
        supabase.from('visits').select('*').eq('patient_id', id).order('date', { ascending: false }),
        supabase.from('progress_notes').select('*').eq('patient_id', id).order('date', { ascending: false }),
        supabase.from('prescriptions').select('*').eq('patient_id', id).order('date', { ascending: false }),
      ]);
      const records = {
        visits: (v.data || []).map(visitFromRow),
        progress: (p.data || []).map(progressFromRow),
        prescriptions: (rx.data || []).map(rxFromRow),
      };
      setRecordsCache((prev) => ({ ...prev, [id]: records }));
    }
  };

  const handleAddPatient = async (data) => {
    const { data: row, error } = await supabase
      .from('patients')
      .insert({
        doctor_id: user.id,
        name: data.name.trim(),
        age: data.age,
        gender: data.gender,
        phone: data.phone,
        address: data.address,
        chronic: data.chronic,
        allergies: data.allergies,
        notes: data.notes,
      })
      .select()
      .single();
    if (error) {
      showToast('تعذر إضافة المريض', 'error');
      return;
    }
    setPatients([patientFromRow(row), ...patients]);
    setModal(null);
    showToast('تم إضافة المريض بنجاح');
  };

  const handleEditPatient = async (id, data) => {
    const { error } = await supabase
      .from('patients')
      .update({
        name: data.name,
        age: data.age,
        gender: data.gender,
        phone: data.phone,
        address: data.address,
        chronic: data.chronic,
        allergies: data.allergies,
        notes: data.notes,
      })
      .eq('id', id);
    if (error) {
      showToast('تعذر تحديث البيانات', 'error');
      return;
    }
    setPatients(patients.map((p) => (p.id === id ? { ...p, ...data } : p)));
    setModal(null);
    showToast('تم تحديث البيانات');
  };

  const handleDeletePatient = async (id) => {
    const { error } = await supabase.from('patients').delete().eq('id', id);
    if (error) {
      showToast('تعذر حذف المريض', 'error');
      return;
    }
    setPatients(patients.filter((p) => p.id !== id));
    setConfirmDelete(null);
    setView('patients');
    setActivePatientId(null);
    showToast('تم حذف المريض');
  };

  const handleAddVisit = async (patientId, data) => {
    const { data: row, error } = await supabase
      .from('visits')
      .insert({
        patient_id: patientId,
        date: data.date || todayISO(),
        complaint: data.complaint,
        diagnosis: data.diagnosis,
        notes: data.notes,
        follow_up_date: data.followUpDate || null,
      })
      .select()
      .single();
    if (error) {
      showToast('تعذر حفظ الكشف', 'error');
      return;
    }
    const visit = visitFromRow(row);
    const records = recordsCache[patientId] || { visits: [], progress: [], prescriptions: [] };
    setRecordsCache((prev) => ({ ...prev, [patientId]: { ...records, visits: [visit, ...records.visits] } }));

    const patch = { last_visit: visit.date };
    if (visit.followUpDate) patch.next_follow_up = visit.followUpDate;
    await supabase.from('patients').update(patch).eq('id', patientId);
    setPatients(patients.map((p) => (p.id === patientId ? { ...p, lastVisit: visit.date, nextFollowUp: visit.followUpDate || p.nextFollowUp } : p)));

    setModal(null);
    showToast('تم تسجيل الكشف');
  };

  const handleAddProgress = async (patientId, data) => {
    const { data: row, error } = await supabase
      .from('progress_notes')
      .insert({ patient_id: patientId, date: data.date || todayISO(), status: data.status, note: data.note })
      .select()
      .single();
    if (error) {
      showToast('تعذر حفظ التطور', 'error');
      return;
    }
    const note = progressFromRow(row);
    const records = recordsCache[patientId] || { visits: [], progress: [], prescriptions: [] };
    setRecordsCache((prev) => ({ ...prev, [patientId]: { ...records, progress: [note, ...records.progress] } }));
    setModal(null);
    showToast('تم إضافة التطور');
  };

  const handleAddPrescription = async (patientId, data) => {
    const { data: row, error } = await supabase
      .from('prescriptions')
      .insert({
        patient_id: patientId,
        date: data.date || todayISO(),
        medications: data.medications || [],
        notes: data.notes,
        image_data: data.imageData || null,
      })
      .select()
      .single();
    if (error) {
      showToast('تعذر حفظ الروشتة', 'error');
      return;
    }
    const rx = rxFromRow(row);
    const records = recordsCache[patientId] || { visits: [], progress: [], prescriptions: [] };
    setRecordsCache((prev) => ({ ...prev, [patientId]: { ...records, prescriptions: [rx, ...records.prescriptions] } }));
    setModal(null);
    showToast('تم حفظ الروشتة');
  };

  const handleAddImage = async (patientId, data) => {
    const { data: row, error } = await supabase
      .from('patient_images')
      .insert({
        patient_id: patientId,
        date: data.date || todayISO(),
        title: data.title,
        image_data: data.imageData,
        notes: data.notes,
      })
      .select()
      .single();
    if (error) {
      showToast('تعذر رفع الصورة', 'error');
      return;
    }
    const img = imageFromRow(row);
    const imgs = imagesCache[patientId] || [];
    setImagesCache((prev) => ({ ...prev, [patientId]: [img, ...imgs] }));
    setModal(null);
    showToast('تم رفع الصورة');
  };

  const TABLE_BY_KEY = { visits: 'visits', progress: 'progress_notes', prescriptions: 'prescriptions' };

  const handleDeleteRecordItem = async (patientId, listKey, itemId) => {
    const { error } = await supabase.from(TABLE_BY_KEY[listKey]).delete().eq('id', itemId);
    if (error) {
      showToast('تعذر الحذف', 'error');
      return;
    }
    const records = recordsCache[patientId] || { visits: [], progress: [], prescriptions: [] };
    setRecordsCache((prev) => ({
      ...prev,
      [patientId]: { ...records, [listKey]: records[listKey].filter((x) => x.id !== itemId) },
    }));
    setConfirmDelete(null);
    showToast('تم الحذف');
  };

  const handleDeleteImageItem = async (patientId, imageId) => {
    const { error } = await supabase.from('patient_images').delete().eq('id', imageId);
    if (error) {
      showToast('تعذر حذف الصورة', 'error');
      return;
    }
    const imgs = imagesCache[patientId] || [];
    setImagesCache((prev) => ({ ...prev, [patientId]: imgs.filter((x) => x.id !== imageId) }));
    setConfirmDelete(null);
    showToast('تم حذف الصورة');
  };

  if (booting) return <LoadingScreen />;
  if (!user) return <AuthScreen />;

  const activePatient = patients.find((p) => p.id === activePatientId) || null;
  const rawRecords = activePatientId ? recordsCache[activePatientId] : undefined;
  const recordsLoading = Boolean(activePatientId) && rawRecords === undefined;
  const activeRecords = rawRecords || { visits: [], progress: [], prescriptions: [] };
  const rawImages = activePatientId ? imagesCache[activePatientId] : undefined;
  const imagesLoading = Boolean(activePatientId) && activeTab === 'images' && rawImages === undefined;
  const activeImages = rawImages || [];

  return (
    <div className="min-h-screen bg-slate-50" dir="rtl" style={{ fontFamily: "Tahoma, 'Segoe UI', Arial, sans-serif" }}>
      <Header
        view={view}
        setView={(v) => {
          setView(v);
          setActivePatientId(null);
        }}
        onLogout={() => supabase.auth.signOut()}
        patientOpen={view === 'patientDetail'}
        onBack={() => {
          setView('patients');
          setActivePatientId(null);
        }}
      />

      {view === 'dashboard' && (
        <Dashboard
          patients={patients}
          onOpenPatient={openPatient}
          onAddPatient={() => setModal({ type: 'addPatient' })}
          onGoPatients={() => setView('patients')}
        />
      )}

      {view === 'patients' && (
        <PatientList
          patients={patients}
          search={search}
          setSearch={setSearch}
          onOpenPatient={openPatient}
          onAddPatient={() => setModal({ type: 'addPatient' })}
        />
      )}

      {view === 'patientDetail' && activePatient && (
        <PatientDetail
          patient={activePatient}
          records={activeRecords}
          recordsLoading={recordsLoading}
          images={activeImages}
          imagesLoading={imagesLoading}
          activeTab={activeTab}
          setActiveTab={setActiveTab}
          onDeletePatient={() => setConfirmDelete({ type: 'patient', id: activePatient.id, label: 'المريض وكل بياناته' })}
          onOpenModal={setModal}
          onDeleteItem={(listKey, itemId, label) =>
            setConfirmDelete({ type: 'record', listKey, itemId, patientId: activePatient.id, label })
          }
          onDeleteImage={(imageId, label) => setConfirmDelete({ type: 'image', imageId, patientId: activePatient.id, label })}
        />
      )}

      {modal && modal.type === 'addPatient' && (
        <Modal title="إضافة مريض جديد" onClose={() => setModal(null)}>
          <PatientForm onSubmit={handleAddPatient} onCancel={() => setModal(null)} />
        </Modal>
      )}
      {modal && modal.type === 'editPatient' && (
        <Modal title="تعديل بيانات المريض" onClose={() => setModal(null)}>
          <PatientForm initial={modal.patient} onSubmit={(data) => handleEditPatient(modal.patient.id, data)} onCancel={() => setModal(null)} />
        </Modal>
      )}
      {modal && modal.type === 'addVisit' && (
        <Modal title="تسجيل كشف جديد" onClose={() => setModal(null)}>
          <VisitForm onSubmit={(data) => handleAddVisit(modal.patientId, data)} onCancel={() => setModal(null)} />
        </Modal>
      )}
      {modal && modal.type === 'addProgress' && (
        <Modal title="إضافة تطور للحالة" onClose={() => setModal(null)}>
          <ProgressForm onSubmit={(data) => handleAddProgress(modal.patientId, data)} onCancel={() => setModal(null)} />
        </Modal>
      )}
      {modal && modal.type === 'addPrescription' && (
        <Modal title="كتابة روشتة" onClose={() => setModal(null)}>
          <PrescriptionForm onSubmit={(data) => handleAddPrescription(modal.patientId, data)} onCancel={() => setModal(null)} />
        </Modal>
      )}
      {modal && modal.type === 'addImage' && (
        <Modal title="رفع صورة أشعة أو تحليل" onClose={() => setModal(null)}>
          <ImageUploadForm onSubmit={(data) => handleAddImage(modal.patientId, data)} onCancel={() => setModal(null)} />
        </Modal>
      )}
      {modal && modal.type === 'viewImage' && (
        <Modal title={modal.image.title || 'عرض الصورة'} onClose={() => setModal(null)}>
          <img src={modal.image.imageData} alt={modal.image.title || 'صورة'} className="w-full rounded-xl" />
          {modal.image.notes && <p className="text-sm text-slate-600 mt-3">{modal.image.notes}</p>}
        </Modal>
      )}

      {confirmDelete && (
        <ConfirmDialog
          label={confirmDelete.label}
          onCancel={() => setConfirmDelete(null)}
          onConfirm={() => {
            if (confirmDelete.type === 'patient') handleDeletePatient(confirmDelete.id);
            else if (confirmDelete.type === 'record') handleDeleteRecordItem(confirmDelete.patientId, confirmDelete.listKey, confirmDelete.itemId);
            else if (confirmDelete.type === 'image') handleDeleteImageItem(confirmDelete.patientId, confirmDelete.imageId);
          }}
        />
      )}

      <ToastView toast={toast} />
    </div>
  );
}
